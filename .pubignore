# pubignore — overrides .gitignore when present; mirror dev-only paths here.

# Dart / Flutter
.dart_tool/
.flutter-plugins-dependencies
**/doc/api/
build/
coverage/
pubspec.lock

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store

# Native build cache
.build/
.swiftpm/
/android/.gradle/
/android/build/

# Maintainer scripts
/scripts/

# AI tooling
.claude/
CLAUDE.md
graphify-out/

# Tests
/test/
/test_app/

# Assets — whitelist only the screenshots referenced by pubspec.yaml
/imgs/*
!/imgs/mpv_audio_kit.png

# The codegen that produces lib/src/generated (tool/codegen/regen.sh)
/tool/
/dart_test.yaml
/android/src/test/
