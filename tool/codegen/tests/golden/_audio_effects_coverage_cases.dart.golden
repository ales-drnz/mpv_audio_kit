/// One filter: [disabled] drops out of the chain, [enabled] is the
/// bare entry (with its [required] options), [wire] sets one option
/// off its default and names the text the entry carries, [bounds] sets
/// one option to a `Min`, `Max` or `Default` constant, and [digits]
/// sets a digit-prefix option through `params`.
final class _Filter {
  const _Filter(
    this.name,
    this.cls,
    this.disabled,
    this.enabled, {
    this.required = const [],
    this.wire = const [],
    this.bounds = const [],
    this.digits = const [],
  });

  final String name;
  final String cls;
  final AudioEffect disabled;
  final AudioEffect enabled;
  final List<String> required;
  final List<(String, AudioEffect, String)> wire;
  final List<(String, String, AudioEffect)> bounds;
  final List<(String, AudioEffect, String)> digits;
}

/// One enum: every member round-trips through `mpvValue` and
/// `fromMpv`, the members carry [wires] in order, and an unknown
/// or null value parses to [first].
final class _Enum<T extends Enum> {
  const _Enum(this.name, this.values, this.parse, this.wire, this.first, this.wires);

  final String name;
  final List<T> values;
  final T Function(String?) parse;
  final String Function(T) wire;
  final T first;
  final List<String> wires;

  void run() {
    test('every member round-trips via mpvValue / fromMpv', () {
      for (final v in values) {
        expect(wire(v), isNotEmpty);
        expect(parse(wire(v)), v);
      }
      expect([for (final v in values) wire(v)], wires);
    });

    test('fromMpv unknown / null → first member (safe fallback)', () {
      expect(parse('this_will_never_match'), first);
      expect(parse(null), first);
    });
  }
}


